# Copia este archivo a .env y completa los valores. NO subas .env a git.

# Anthropic (Claude) - generación de respuestas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenRouter - embeddings (nvidia/nemotron-3.5-embed-1b:free)
# Usa una API key normal (no una Management key).
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=FMC130 Soporte RAG

# MongoDB Atlas local (contenedor)
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=
MONGODB_HOST_PORT=27040
# Puerto TLS (proxy mongo-tls). MONGODB_URI usa este puerto y tlsCAFile (ejecutar scripts desde la raíz).
MONGODB_TLS_HOST_PORT=27041
MONGODB_URI=mongodb://admin:CAMBIAR@localhost:27041/?authSource=admin&directConnection=true&tls=true&tlsCAFile=certs/mongo-cert.pem
MONGODB_DATABASE=fmc130_rag
MONGODB_COLLECTION=parameters
